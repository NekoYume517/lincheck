///| Int32 最小值的前导零不能改变其数值或合法性。
///
/// 旧实现只在原始字符串恰好为 "-2147483648" 时放行最小值；
/// 加一个前导零后，逐位累加会把绝对值 2147483648 当成溢出拒绝。

///|
test "parse_int_arg 接受带前导零的 Int32 最小值" {
  inspect(parse_int_arg("-0002147483648"), content="Some(-2147483648)")
  inspect(
    parse_int_arg("-0000000000000000000002147483648"),
    content="Some(-2147483648)",
  )
  // 真正的越界值即使有前导零也仍然必须拒绝。
  inspect(parse_int_arg("-0002147483649"), content="None")
}
