// cli_concurrency_domain_test.mbt — `--concurrency` 取值域的十进制原文判据
//
// 锁定的缺陷（2026-11-21 审计 LC-23，11-21 轮 #1）：
//
// `concurrency_in_domain` 拿 **Double** 判域，而 `parse_double_arg` 把十进制
// 原文折成 Double 时会在 1.0 附近四舍五入。于是「原文严格大于 1」的一条带
// 子被静默放行：
//
// ```text
// $ lincheck gen --model register --processes 2 --ops 3 --seed 1 \
//     --concurrency 1.000000000000000001
// （exit 0，输出与 --concurrency 1 逐字节相同）
// ```
//
// 1 + 1e-18 在 Double 里就是 1.0（ulp(1.0) ≈ 2.2e-16），所以域检查看到的是
// 1.0 而不是 1.000000000000000001。同族 LC-5 / LC-15 / LC-22 的口径是
// 「判据按**十进制原文**，不按 Double 容量」：`2.5` 会被拦、`0.000…01`
// 会被接受，那么 `1.000…01` 也必须被拦。
//
// 判据写全（`main.mbt` `decimal_is_above_one`）：
// - 整数段去掉前导零后 > 1 → 越界；
// - 整数段 == 1 且小数段含非零数字 → 越界（就是本条）；
// - 整段全零 / 负数 → 不越界（负号交给 Double 判据处理，`-0` 必须放行）；
// - `NaN` / `Infinity` / 指数记法 `1e-1` 在 `parse_double_arg` 的语法里
//   根本不存在（只认 `'-'? digits ('.' digits)?`），所以不进这条判据。

///|
/// 域外：十进制原文 > 1，但 Double 四舍五入回 1.0。
///
/// 19 位、18 位、37 位三种写法都要走同一条判据 —— 只堵最长的那个会把
/// 同族入口留成「短一点就漏」。
test "LC-23: 原文 > 1 的并发度必须报用法错误（Double 回绕到 1.0 不得放行）" {
  for
    v in [
      "1.000000000000000001", "1.0000000000000000001", "1.0000000000000000000000000000000000009",
      "1.00000000000000000000000000000000000001",
    ] {
    inspect(
      run([
        "lincheck", "gen", "--model", "register", "--processes", "2", "--ops", "3",
        "--seed", "1", "--concurrency", v,
      ]),
      content="2",
    )
  }
}

///|
/// 守护：原文 ≤ 1 的值一个都不能被新判据误伤。
///
/// 这是「改判据时顺手拦掉合法值」的高频事故面（`-0`、30 个 9、30 个 0
/// 都是真实会出现在脚本里的写法）。
test "LC-23 守护: 原文 ≤ 1 的并发度仍然接受（含 -0 / 长尾 0.999… / 1.000…）" {
  for
    v in [
      "0", "-0", "-0.0", "0.5", "1", "1.0", "1.000000000000000000000000000000", "0.999999999999999999",
      "0.999999999999999999999999999999", "0.0000000000000000001",
    ] {
    inspect(
      run([
        "lincheck", "gen", "--model", "register", "--processes", "2", "--ops", "3",
        "--seed", "1", "--concurrency", v,
      ]),
      content="0",
    )
  }
}

///|
/// 域外负值：`-0.5` 与「负号 + 一长串 0 再一个 1」都必须 exit 2，且
/// 报错里出现的是**原文**（用户能对着自己写的参数找问题）。
test "LC-23: 域外负值仍然 exit 2（原文判据不得吃掉负号分支）" {
  for v in ["-0.5", "-1", "-0.0000000000000000001", "-1.000000000000000001"] {
    inspect(
      run([
        "lincheck", "gen", "--model", "register", "--processes", "2", "--ops", "3",
        "--seed", "1", "--concurrency", v,
      ]),
      content="2",
    )
  }
}
