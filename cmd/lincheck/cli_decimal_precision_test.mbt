// LC-22：长小数的前导零不是“有效精度预算”。
// parse_double_arg 旧实现只取小数点后的前 18 个字符；对于 1e-19 这样的
// 合法值，前 18 位全是 0，唯一有效位被直接截掉，最终静默变成 0.0。

///|
test "LC-22: 第 19 个十进制位上的有效数字不得被截成零" {
  assert_eq(
    parse_double_arg("0.0000000000000000001"),
    Some(0.0000000000000000001),
  )
  assert_eq(
    parse_double_arg("-0.0000000000000000001"),
    Some(-0.0000000000000000001),
  )
}

///|
test "LC-22: 前导零之后的 18 位有效数字仍被保留" {
  let value = parse_double_arg("0.000000000000000000123456789012345678")
  match value {
    Some(v) => {
      assert_true(v > 0.0)
      assert_true(v < 0.000000000000000001)
    }
    None => fail("域内长小数应可解析")
  }
}
