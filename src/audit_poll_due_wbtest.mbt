// ============================================================================
// LC-13：轮询三档的契约必须由**纯函数**锁住，而不是由「机器多快」锁住
//
// 2026-11-12 的 L-1 修复把截止检查从「每 256 个节点」改成三档
// （`poll_due`：1..64 每 1 个、65..1024 每 16 个、>1024 每 256 个）。
// 当时的回归断言是「1 ms 预算下 `stats.explored <= 64`」——它把
// **机器速度**写进了断言：机器快 6 倍以上时 1 ms 能跑过 64 个节点，用例就红，
// 而实现完全正确（同一族的 flaky 在 2026-11-13 的 LC-7 上已经吃过一次）。
//
// 这一版的契约改成对 `poll_due` 本身断言：纯函数、不看时钟、与机器无关。
// 三档的性质有两条，缺一不可：
//   1. **覆盖**：`1..64` 每个节点都检查（小预算唯一的救火档）；
//   2. **超集**：256 的整数倍（旧口径的检查点）一个都不许丢 ——
//      否则「大搜索的检查点集合与旧实现逐个相同」这条承诺就不成立了。
// ============================================================================

///|
test "LC-13: 轮询三档是纯函数契约（前 64 个节点逐个检查）" {
  let mut i = 1
  while i <= 64 {
    // 密档：1..64 每个节点都必须看时钟，否则 1 ms 预算会拖到第 65 个节点。
    assert_true(poll_due(i))
    i = i + 1
  }
}

///|
test "LC-13: 中档每 16 个节点、稀疏档每 256 个节点" {
  // 中档（65..1024）：每 16 个一次；65..79 不是 16 的倍数 → 不查。
  let mut i = 65
  while i < 80 {
    assert_true(!poll_due(i))
    i = i + 1
  }
  assert_true(poll_due(80))
  assert_true(poll_due(1024))
  assert_true(!poll_due(1021))
  // 稀疏档（>1024）：仅 256 的倍数。
  assert_true(!poll_due(1025))
  assert_true(!poll_due(1279))
  assert_true(poll_due(1280))
  assert_true(poll_due(256 * 100))
}

///|
test "LC-13: 稀疏档的检查点必须是旧口径（每 256）的超集" {
  // 旧实现：`explored % 256 == 0`。新三档不许丢掉其中任何一个，
  // 否则 5000 ms 档的大搜索会在与原实现不同的节点上超时。
  let mut i = 256
  while i <= 256 * 64 {
    assert_true(poll_due(i))
    i = i + 256
  }
}
